# =========================================================
# TradeOwl — LOCAL DEV env template
# =========================================================
# 사용법: 이 파일을 .env 로 복사해서 값을 채운다 (cp .env.example .env).
# .env 는 gitignore 됨 (로컬 전용).
# 프로덕션 시크릿은 이 파일이 아니라 배포 파이프라인이 주입한다 (docs/environments.md).

# [Environment]
# 로컬 개발은 항상 local. prod 로 바꾸지 말 것 (배포는 파이프라인이 처리).
SPRING_PROFILES_ACTIVE=local

# [Frontend → Backend]
# 로컬: 백엔드를 8080 로 직접 실행하므로 아래 값. (배포 시엔 /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# [Database — 로컬 dev]
# docker-compose.yml(dev)의 기본 자격증명과 일치시킨다.
DB_NAME=tradeowl
DB_USER=tradeowl
DB_PASS=tradeowl_local_dev

# [External APIs — KIS Open API]
# KIS 개발자 포털(https://apiportal.koreainvestment.com)에서 발급.
# 실제 시세/거래 데이터를 쓰려면 진짜 키가 필요하다 (없으면 시뮬레이션만 동작).
# 앱키는 ~36자, 시크릿은 ~180자. 짧으면 더미 값이다.
KIS_APP_KEY=
KIS_APP_SECRET=

# [Optional] 시스템 알림 (없으면 비워둠)
SYSTEM_DISCORD_WEBHOOK_URL=
